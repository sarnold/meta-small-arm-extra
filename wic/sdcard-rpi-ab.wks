# short-description: Create Raspberry Pi SD card image
# long-description: Creates a partitioned SD card image for use with
# swupdate AB rootfs. Boot files are located in the first vfat partition.

part /boot --size 256M --source bootimg-partition --ondisk mmcblk0 --fstype=vfat --label boot --active --align 4096
part / --size 400M --source rootfs --ondisk mmcblk0 --fstype=ext4 --label root --align 4096
part /dummy --size 400M --source rootfs --ondisk mmcblk0 --fstype=ext4 --label root2 --align 4096
part /media --size 1G --ondisk mmcblk0 --fstype=ext4 --label data --align 4096
